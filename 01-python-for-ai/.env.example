# Copy this file to `.env` and fill in real values:    cp .env.example .env
# `.env` is listed in .gitignore, so your real key never reaches GitHub.
# THIS example file has no real secrets, so it IS safe to commit.

ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=claude-sonnet-5
MAX_RETRIES=3
TIMEOUT_SECONDS=30
